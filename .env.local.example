# Tesla Show 环境配置示例文件
# 复制此文件为 .env.local 并填入您的实际配置值

# 开发环境配置
NODE_ENV=development

# 数据库配置 - TeslaMate PostgreSQL 数据库连接信息
# 请根据您的 TeslaMate 安装配置修改以下信息
DB_HOST=localhost
DB_PORT=5433
DB_NAME=teslamate
DB_USER=teslamate
DB_PASSWORD=your_database_password_here
TESLASHOW_USER=username      
TESLASHOW_PASSWORD=password 

# 天地图API配置
# 请在天地图官网 (https://www.tianditu.gov.cn/) 注册并申请浏览器端 Key
NEXT_PUBLIC_TDT_KEY=your_tdt_key_here

# 配置说明：
# 1. DB_HOST: TeslaMate 数据库服务器地址
# 2. DB_PORT: PostgreSQL 数据库端口，默认为 5432
# 3. DB_NAME: TeslaMate 数据库名称，通常为 teslamate
# 4. DB_USER: 数据库用户名
# 5. DB_PASSWORD: 数据库密码
# 6. NEXT_PUBLIC_TDT_KEY: 天地图浏览器端 API Key

# 注意事项：
# - 请确保您的 TeslaMate 实例正在运行且数据库可访问
# - 天地图 API 密钥需要在天地图官网申请
# - 请勿将包含真实密钥的 .env.local 文件提交到版本控制系统